{
  "schema_version": 2,
  "suite_id": "replace-with-project-workflow-v1",
  "description": "Bring-your-own-repository Inspect scenario. Review every path, command, and permission before running.",
  "fixture_root": "../../source-repo",
  "task": "Run the project test suite and report its verified result.",
  "agent": {
    "kind": "configured-executable",
    "program": "/usr/bin/python3",
