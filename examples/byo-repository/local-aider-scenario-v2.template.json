      "{sample_id}",
      "--model-seed",
      "{model_seed}"
    ],
    "diagnostics_argv": ["--retain-diagnostics"]
  },
  "verifier": {
    "program": "/usr/bin/python3",
    "argv": ["-B", "-m", "unittest", "discover", "-s", "tests", "-v"],
